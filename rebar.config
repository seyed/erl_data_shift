%% Compiler options: debug_info is needed for stack traces and tools
{erl_opts, [debug_info]}.

%% Dependencies: Empty for now as this is initial.
{deps, [
    {epgsql, "4.7.1"}
]}.

%% Ensure test/ is compiled without polluting src_dirs (correct way for rebar3 >= 3.14)
{extra_src_dirs, [{"test", [{recursive, true}]}]}.

{eunit_opts, [verbose]}.
{cover_enabled, true}.

%% Release configuration (using relx)
{relx, [
    {release, {erl_data_shift, "0.2.9"}, [erl_data_shift, epgsql]},

    %% Dev mode: true for fast local rebuilds (symlinks code)
    {dev_mode, true},

    %% ERTS: false for dev (uses system Erlang), true for prod (standalone)
    {include_erts, false}
]}.

%% Profiles
{profiles, [
    {test, [
        {deps, [meck]},                          %% mocking lib, test-only
        {erl_opts, [debug_info, nowarn_export_all]}
    ]},
    {prod, [
        {erl_opts, [no_debug_info, warnings_as_errors]},
        {relx, [
            {dev_mode, false},      %% Copy files physically
            {include_erts, true}    %% Bundle Erlang Runtime (no install needed)
        ]}
    ]}
]}.

%% Custom CI command: rebar3 check
{alias, [
    {check, [eunit, ct, dialyzer]}
]}.
