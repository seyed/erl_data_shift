%% Compiler options: debug_info is needed for stack traces and tools
{erl_opts, [debug_info]}.

%% Dependencies: Empty for now as this is initial. 
{deps, []}.

%% Release configuration (using relx)
{relx, [
    %% Define the release: {Name, Version, [Apps]}
    {release, {"erl_data_shift", "0.1.0"}, [erl_data_shift]},
    
    %% Dev mode: true for fast local rebuilds (symlinks code)
    {dev_mode, true},
    
    %% ERTS: false for dev (uses system Erlang), true for prod (standalone)
    {include_erts, false}
]}.

%% Profiles: Define a 'prod' profile for the final standalone binary
{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},      %% Copy files physically
            {include_erts, true}    %% Bundle Erlang Runtime (no install needed)
        ]}
    ]}
]}.   
