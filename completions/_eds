#compdef eds
# Zsh completion for eds. Install:
#   Place this file (named _eds) in a directory on your $fpath, e.g.:
#   cp _eds /usr/local/share/zsh/site-functions/_eds
# then restart your shell or run: autoload -U compinit && compinit

_eds() {
    local -a commands
    commands=(
        'con_check:Tests Postgres connectivity using your .env credentials'
        'stat:Shows table names, row counts, and storage size'
        'history:Shows applied migrations with drift check'
        'migrate:Runs all pending .sql files transactionally'
        'new:Scaffolds a new numbered up+down migration file pair'
        'validate:Test-runs pending migrations in a rolled-back transaction'
        'verify:Checks applied migration files for checksum drift'
        'init:Scaffolds migrations/ and .env.example'
        'version:Prints the eds version'
        'help:Shows the help message'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi

    case "${words[2]}" in
        migrate)
            local -a migrate_opts
            migrate_opts=('down:Roll back the last migration' 'dry-run:List pending without applying' 'force:Bypass checksum drift check' 'json:JSON output' '-f:Custom migrations directory' '--path:Custom migrations directory')
            _describe 'migrate option' migrate_opts
            ;;
        validate|verify)
            local -a opts
            opts=('json:JSON output' '-f:Custom migrations directory' '--path:Custom migrations directory')
            _describe 'option' opts
            ;;
        stat|con_check)
            local -a opts
            opts=('json:JSON output')
            _describe 'option' opts
            ;;
    esac
}

_eds